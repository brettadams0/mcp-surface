{
  "name": "mcp-surface",
  "version": "0.3.0",
  "description": "See the tool surface your MCP server actually exposes: probe it like a real client, validate schemas, and fail CI when the surface changes unintentionally.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "ci",
    "cli"
  ],
  "license": "MIT",
  "author": "Brett Adams",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brettadams0/mcp-surface.git"
  },
  "bugs": {
    "url": "https://github.com/brettadams0/mcp-surface/issues"
  },
  "homepage": "https://github.com/brettadams0/mcp-surface#readme",
  "type": "module",
  "bin": {
    "mcp-surface": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
